Total Claims = DISTINCTCOUNT(Fact[Claim_ID])
Unique Patients = DISTINCTCOUNT(Fact[Patient_ID])
Total Billed = SUM(Fact[Claim_Amount])
Total Allowed = SUM(Fact[Allowed_Amount])
Total Paid = SUM(Fact[Paid_Amount])
Payment Rate = DIVIDE([Total Paid],[Total Allowed],0)
Average Claim Amount = AVERAGE(Fact[Claim_Amount])
Average Submission Lag = AVERAGE(Fact[Submission_Lag_Days])
Denied / Rejected Claims = CALCULATE([Total Claims],Fact[Claim_Status] IN {"Denied","Rejected"})
Denial / Rejection Rate = DIVIDE([Denied / Rejected Claims],[Total Claims],0)
Flagged Claims = CALCULATE([Total Claims],Fact[Anomaly_Flag]=1)
Financial Exceptions = CALCULATE([Total Claims],Fact[Financial_Exception]=1)
Provider Volume Spikes = CALCULATE([Total Claims],Fact[Provider_Week_Spike]=1)
Missing Provider Claims = CALCULATE([Total Claims],Fact[Missing_Provider]=1)
